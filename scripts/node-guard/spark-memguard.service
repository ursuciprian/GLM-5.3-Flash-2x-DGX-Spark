[Unit]
Description=DGX Spark memory guard (stops inference before the host starves)
After=docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/spark-memguard.sh
Restart=always
RestartSec=5
# the guard itself must never be the thing that gets killed
OOMScoreAdjust=-900
MemoryMin=64M

[Install]
WantedBy=multi-user.target
